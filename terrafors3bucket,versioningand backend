provider "aws" {
  region = "ap-south-1"
}

#################################################
# S3 BUCKET
#################################################

resource "aws_s3_bucket" "ravikumar_bucket" {
  bucket = "ravikumar-terraform-state-bucket-2026"

  tags = {
    Name        = "RavikumarTerraformStateBucket"
    Environment = "Dev"
    Owner       = "Ravikumar"
  }
}

#################################################
# S3 VERSIONING
#################################################

resource "aws_s3_bucket_versioning" "versioning" {
  bucket = aws_s3_bucket.ravikumar_bucket.id

  versioning_configuration {
    status = "Enabled"
  }
}

#################################################
# DYNAMODB TABLE
#################################################

resource "aws_dynamodb_table" "tf_lock" {

  name         = "terraform-lock-table-demo"
  billing_mode = "PAY_PER_REQUEST"
  hash_key     = "LockID"

  attribute {
    name = "LockID"
    type = "S"
  }
}
